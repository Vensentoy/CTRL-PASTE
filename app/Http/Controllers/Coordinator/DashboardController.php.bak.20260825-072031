<?php

namespace App\Http\Controllers\Coordinator;

use App\Http\Controllers\Controller;
use App\Models\Coordinator;
use App\Models\MonthlyAccomplishmentReport;
use App\Models\WeeklyAccomplishmentReport;
use Illuminate\Database\Eloquent\Collection;
use Illuminate\View\View;

/**
 * Coordinator landing page after login. Every query is scoped through
 * $request->user()->coordinator (BR-11) — never a bare Student::all() or
 * SubmissionCycle::all() — so a coordinator only ever sees their own
 * students and cycles here, matching the same isolation guarantee already
 * enforced in DarReviewController.
 *
 * THIS SESSION — cohort-wide progress dashboard. Previously this only
 * counted pending DAR per student. Added:
 *   - WAR pending-review counts, reusing WeeklyAccomplishmentReport's
 *     existing week{1..4}_status columns (BR-7: each week-section is
 *     independently statused, so this sums Pending/Late across all four
 *     per student rather than treating the row as one unit).
 *   - MAR pending-review counts, reusing MonthlyAccomplishmentReport's
 *     existing single `status` field.
 *   - An overdue/Missed count per BR-6 — see missedDarCycleCount() and
 *     lateWarWeekCount()/lateMarCount() below for the deliberate scope
 *     limitation on WAR/MAR (flagged there, not silently glossed over).
 *   - A roster-wide completion-rate summary (Completed vs Ongoing).
 * No new columns were added anywhere — every count here reads fields
 * that already existed before this session.
 */
class DashboardController extends Controller
{
    public function index(): View
    {
        $coordinator = request()->user()->coordinator;

        $students = $coordinator->students()
            ->withCount([
                'dailyAccomplishmentReports as pending_dar_count' => function ($query) {
                    $query->whereIn('status', ['Pending', 'Late']);
                },
            ])
            ->orderBy('surname')
            ->get();

        $this->attachWarMarCounts($students);
        $this->attachOverdueCounts($coordinator, $students);

        $openCycles = $coordinator->submissionCycles()
            ->whereDate('deadline_date', '>=', now()->toDateString())
            ->orderBy('deadline_date')
            ->get();

        // Same Pending/Late definition DarReviewController::review() /
        // WarReviewController::review() / MarReviewController::review()
        // act on, just summed here for at-a-glance cohort totals.
        $totalPendingDar = $students->sum('pending_dar_count');
        $totalPendingWar = $students->sum('pending_war_count');
        $totalPendingMar = $students->sum('pending_mar_count');
        $totalOverdue = $students->sum('overdue_count');

        // BR-11: roster-wide, this coordinator's own students only.
        $completedCount = $students->where('ojt_status', 'Completed')->count();
        $ongoingCount = $students->count() - $completedCount;
        $completionRate = $students->count() > 0
            ? round(($completedCount / $students->count()) * 100, 1)
            : 0.0;

        return view('coordinator.dashboard', compact(
            'coordinator',
            'students',
            'openCycles',
            'totalPendingDar',
            'totalPendingWar',
            'totalPendingMar',
            'totalOverdue',
            'completedCount',
            'ongoingCount',
            'completionRate',
        ));
    }

    /**
     * Adds pending_war_count / pending_mar_count onto each already-loaded
     * Student in the collection. Done as a separate pass (not folded into
     * the withCount() chain above) because WAR's "pending" isn't a single
     * relation-count the way DAR's is — BR-7 spreads it across four
     * week{n}_status columns on one row, so it needs its own per-student
     * query instead of a stock ->withCount() aggregate.
     */
    private function attachWarMarCounts(Collection $students): void
    {
        foreach ($students as $student) {
            $warPending = 0;

            // One WAR row per student per month (BR-8) — could be many
            // rows across a student's whole OJT run, so this deliberately
            // sums across ALL of a student's WAR rows, not just the
            // current month, to give an honest cohort-wide total rather
            // than only "this month's" pending count.
            $wars = WeeklyAccomplishmentReport::where('student_id', $student->id)->get();
            foreach ($wars as $war) {
                foreach ([1, 2, 3, 4] as $week) {
                    if (in_array($war->{"week{$week}_status"}, ['Pending', 'Late'], true)) {
                        $warPending++;
                    }
                }
            }

            $marPending = MonthlyAccomplishmentReport::where('student_id', $student->id)
                ->whereIn('status', ['Pending', 'Late'])
                ->count();

            $student->pending_war_count = $warPending;
            $student->pending_mar_count = $marPending;
        }
    }

    /**
     * Adds overdue_count onto each Student — a BR-6-derived "how many
     * things did this student miss" tally.
     *
     * SCOPE LIMITATION, FLAGGED (not silently glossed over): this counts
     * two different kinds of overdue signal, deliberately NOT the same
     * shape for all three document types:
     *
     *   - DAR: true "Missed" detection — for every past-deadline cycle
     *     under this coordinator, a student with ZERO DAR rows in that
     *     cycle counts as one Missed cycle. This is safe to compute
     *     because DAR is submitted into every cycle by design (workflows.md
     *     §3) — there's no ambiguity about which cycle a DAR "should" have
     *     landed in.
     *   - WAR / MAR: counts already-stored 'Late' statuses only (a
     *     week{n}_status or MAR status that IS 'Late' — meaning something
     *     WAS eventually submitted, just after the deadline). This does
     *     NOT catch "never submitted at all" for WAR/MAR the way the DAR
     *     count does. The reason: unlike DAR, WAR's four weeks map onto
     *     specific cycle SLOTS (Week 1–2 vs Week 3–4, per BR-8's
     *     weekPairForCycle()) and MAR is submitted once per month, not
     *     once per cycle — so "nothing submitted into cycle X" isn't
     *     automatically a miss the way it is for DAR; it might just be
     *     the wrong slot for that document type. Correctly reconstructing
     *     "was this WAR week-pair or this MAR actually due by this
     *     specific past cycle's deadline" needs the same slot-aware logic
     *     Student\DashboardController::activeCycleDocumentStatus() already
     *     has for the CURRENT cycle — extending that same logic backward
     *     across every historical cycle for every student was judged out
     *     of scope for this session's dashboard pass. Flagging this
     *     explicitly here and in PROJECT_STATE.md rather than shipping a
     *     WAR/MAR "Missed" number that would be silently wrong for some
     *     students.
     *
     * SECOND SCOPE LIMITATION, ALSO FLAGGED: a past cycle only counts as
     * "missed" for a student if its deadline fell on/after that student's
     * ojt_start_date — this avoids flagging a cycle that existed before
     * the student's OJT period even began. What this does NOT account
     * for: a student REASSIGNED onto this coordinator partway through
     * (BR-1) has no "assigned since" timestamp anywhere in data-model.md,
     * so a past cycle created by this coordinator before the reassignment
     * happened, but after the student's ojt_start_date, can still count
     * as missed even though the student was never actually this
     * coordinator's responsibility for it. This is the same "no
     * assignment-history timestamp" gap already flagged in
     * AuditLogController's docblock for a different feature — same root
     * cause, surfacing here too. Left as-is rather than adding a schema
     * change this session wasn't scoped to make.
     */
    private function attachOverdueCounts(Coordinator $coordinator, Collection $students): void
    {
        $pastCycles = $coordinator->submissionCycles()
            ->whereDate('deadline_date', '<', now()->toDateString())
            ->get(['id', 'deadline_date']);

        foreach ($students as $student) {
            $missedDarCycles = 0;

            $eligibleCycles = $student->ojt_start_date
                ? $pastCycles->filter(fn ($cycle) => $cycle->deadline_date->gte($student->ojt_start_date))
                : $pastCycles;

            if ($eligibleCycles->isNotEmpty()) {
                $eligibleCycleIds = $eligibleCycles->pluck('id');

                $submittedIntoCycles = $student->dailyAccomplishmentReports()
                    ->whereIn('cycle_id', $eligibleCycleIds)
                    ->distinct()
                    ->pluck('cycle_id');

                $missedDarCycles = $eligibleCycleIds->diff($submittedIntoCycles)->count();
            }

            $lateWarWeeks = 0;
            $wars = WeeklyAccomplishmentReport::where('student_id', $student->id)->get();
            foreach ($wars as $war) {
                foreach ([1, 2, 3, 4] as $week) {
                    if ($war->{"week{$week}_status"} === 'Late') {
                        $lateWarWeeks++;
                    }
                }
            }

            $lateMar = MonthlyAccomplishmentReport::where('student_id', $student->id)
                ->where('status', 'Late')
                ->count();

            $student->overdue_count = $missedDarCycles + $lateWarWeeks + $lateMar;
        }
    }
}
